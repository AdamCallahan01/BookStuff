---
layout: base.njk
permalink: /books/
---

<h1>All Books</h1>

{% set sortedBooks = collections.books | sort(attribute="data.title") %}

<div class="book-grid">
  {% for book in sortedBooks %}
    <a href="{{ book.url }}" class="book-card">

      {% if book.data.coverSlug %}
        <img
          class="book-cover"
          src="/files/covers/{{ book.data.coverSlug }}.jpg"
          alt="{{ book.data.title }} cover"
        >
      {% endif %}

      <div class="overlay">
        ⭐ {% if book.data.hasScore %}{{ book.data.averageScore }}{% else %}N/A{% endif %}
        | 📖 {{ book.data.readCount }}
      </div>

      <h2 class="book-title">{{ book.data.title }}</h2>
      <p class="book-author">{{ book.data.author }}</p>

    </a>
  {% endfor %}
</div>