---
layout: base.njk
permalink: /books/
title: All Books
keywords: fantasy, books, fantasy books, filtering, sorting, ranking
description: A filterable list of all the books I have read
---

{% block extraHead %}
  <script src="/js/nouislider.min.js" defer></script>
  <script src="/js/bookFilter.js" defer></script>
{% endblock %}

<div class="books-page">

  <aside class="sidebar sidebar-left" id="leftSidebar">
    <h2>Filters</h2>

    <div class="slider-group">
      <label for="scoreSlider">Score Range:</label>
      <div id="scoreSlider"></div>
      <div id="scoreLabel"></div>
    </div>

    <div class="slider-group">
      <label for="pageSlider">Page Range:</label>
      <div id="pageSlider"></div>
      <div id="pageLabel"></div>
    </div>

    <div id="countSliderParent" class="slider-group">
      <label for="countSlider">Count:</label>
      <div id="countSlider"></div>
      <div id="countLabel"></div>
    </div>

    <div class="checkbox-group">
      <label for="hasScoreToggle" id="hasScoreToggleParent" class="checkbox-row">
        <input type="checkbox" id="hasScoreToggle" value="true">
          Has Score?
        </label>

      <label for="hasSummaryToggle" id="hasSummaryToggleParent" class="checkbox-row">
        <input type="checkbox" id="hasSummaryToggle" value="true">
          Has Summary?
        </label>

      <label for="hasReviewToggle" id="hasReviewToggleParent" class="checkbox-row">
        <input type="checkbox" id="hasReviewToggle" value="true">
          Has Review?
        </label>

      <label for="isOwnedToggle" id="isOwnedToggleParent" class="checkbox-row">
        <input type="checkbox" id="isOwnedToggle" value="true">
          Owned?
        </label>
    </div>

    <select id="yearReadFilter" class="filter-select">
      <option value="">Any</option>
    </select>

    <select id="formatFilter" class="filter-select">
      <option value="">All Formats</option>
    </select>

    <button id="scrollTopBtn" title="Scroll to top" class="scroll-top-btn">
      Top ↑
    </button>

  </aside>

  <main class="content">
    <h1 id="pageTitle">{{ title }}</h1>

    <div class="mobile-sidebar-controls">
      <button
        class="sidebar-toggle left-toggle"
        id="leftSidebarFilterToggle"
      >
        ☰
      </button>
    </div>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>

    <button
      class="mobile-filter-toggle"
      aria-expanded="false"
      aria-controls="mobileFilters"
    >
      Filters & Sort
    </button>

    <div class="filter-group" id="mobileFilters">

      <div class="filter-row">
        <section>

          <h3>Filters</h3>

          <select id="combineToggle" class="filter-select">
            <option value="book">Books</option>
            <option value="series">Series</option>
            <option value="read">Reads</option>
            <option value="author">Authors</option>
          </select>

          <div class="search-controls">
            <input
            id="booksSearchInput"
            placeholder="Search..."
            autocomplete="off"
            class="filter-input"
          >

            <div class="search-options">
              <label><input id="booksSearchTitle" type="checkbox" value="true" checked>Title</label>
              <label><input id="booksSearchAuthor" type="checkbox" value="true" checked>Author</label>
              <label><input id="booksSearchSeries" type="checkbox" value="true" checked>Series</label>
            </div>
          </div>

          <select id="authorFilter" class="filter-select">
            <option value="">All Authors</option>
          </select>

          <select id="seriesFilter" class="filter-select">
            <option value="">All Series</option>
          </select>

          <select id="genreFilter" class="filter-select">
            <option value="">All Genres</option>
          </select>

        </section>

        <section>
          <h3>Sort</h3>

          <select id="sortField" class="filter-select"></select>

          <select id="sortDirection" class="filter-select">
            <option value="asc">Ascending</option>
            <option value="desc">Descending</option>
          </select>

        </section>

      </div>

      <div class="filter-actions">
        <button id="filterResetButton" class="button-danger">Reset</button>
      </div>

    </div>

    <div class="stats">
      <span>Count: <strong id="bookNumberLabel">0</strong></span>
      <span>Pages: <strong id="pageCountLabel">0</strong></span>
      <span>Avg Pages: <strong id="pageAverageLabel">0</strong></span>
      <span>Avg Score: <strong id="scoreAverageLabel">0</strong></span>
    </div>

    <hr>

    <div id="booksView" class="book-grid book-grid-hidden"></div>

  </main>

</div>
