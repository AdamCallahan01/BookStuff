---
layout: base.njk
permalink: /lists/
title: Favorite Fantasy Book and Series
keywords: fantasy, book ranking, book reviews, best fantasy, best books, favorite fantasy, top fantasy books of all time, top fantasy series
description: Rankings of my favorite books and series | Top 100 Fantasy Books Ever
---

<h1>Best Fantasy Books</h1>

{% macro renderList(items, title, isSeries) %}
  <details class="ranking-panel">
    <summary>
      <h2>{{ title }}</h2>
    </summary>

    <div class="ranking-content">
      <ol class="ranked-list">
        {% if isSeries %}
          {% for series in items %}
            {% set curSeries = series | booksBySeries(collections.books) %}
            <li class="rank-item">
              <div class="rank-item-inner">
                {% seriesMosaic curSeries %}
                <div class="rank-text">
                  <div class="rank-title">
                    <a href="/books/?series={{ series | lower | urlencode }}">{{ series }}</a>
                  </div>

                  <div class="rank-meta">
                    {{ curSeries[0].data.author }}
                  </div>
                </div>

              </div>
            </li>

          {% endfor %}
        {% else %}
          {% for title in items %}
            {% set book = title | bookByTitle(collections.books) %}

            <li class="rank-item">

              <div class="rank-item-inner">

                {% if book and book.data.coverSlug %}
                  <div class="book-cover-list">
                    {% bookCover book.data.coverSlug, book.data.title %}
                  </div>
                {% endif %}

                <div class="rank-text">
                  {% if book %}
                    <div class="rank-title">
                      <a href="{{ book.url }}">{{ book.data.title }}</a>
                    </div>
                    <div class="rank-meta">
                      {{ book.data.series }} — {{ book.data.author }}
                    </div>
                  {% else %}
                    <div class="rank-title">{{ title }}</div>
                  {% endif %}
                </div>

              </div>

            </li>

          {% endfor %}
        {% endif %}
      </ol>
    </div>
  </details>
{% endmacro %}

{########################## LISTS ##################################}

<div class="rankings-wrapper">

  {% for list in lists %}
    {{ renderList(list.items, list.title, list.isSeries) }}
  {% endfor %}

</div>