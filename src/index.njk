---
layout: base.njk
permalink: /
---

<div class="home-layout">

  <aside class="sidebar sidebar-left">
    {% if page.url == "/" %}
      {% include "randomTrivia.njk" %}
      {% include "randomWord.njk" %}
    {% endif %}
  </aside>

  <section>
    <div class="mobile-sidebar-controls">

      <button
        class="sidebar-toggle left-toggle"
        id="leftSidebarToggle"
      >
        ☰
      </button>

      <button
        class="sidebar-toggle right-toggle"
        id="rightSidebarToggle"
      >
        🎲
      </button>

    </div>

    <div class="sidebar-backdrop" id="sidebarBackdrop"></div>
    <h1>Current Reads:</h1>

    <div class="current-reads">

      {% set currentReads = collections.books | filterTruthy("currentRead") %}

      {% if currentReads | length > 0 %}
        <div class="book-grid">
          {% for book in currentReads %}

            {% set readForBook = null %}
            {% for r in collections.reads %}
              {% if r.data.bookSlug == book.data.bookSlug %}
                {% set readForBook = r %}
              {% endif %}
            {% endfor %}

            <a href="{{ book.url }}" class="card book-card">
              {% if book.data.coverSlug %}
                <img src="/files/covers/{{ book.data.coverSlug }}.jpg" alt="{{ book.data.title }} cover">
              {% endif %}
              <div class="overlay">
                {% if readForBook %}
                  {% if readForBook.data.dateStarted %}🗓️ {{ readForBook.data.dateStarted }} |{% endif %}
                {% endif %}
              📖 {{ book.data.readCount }}
              </div>
              <h2>{{ book.data.title }}</h2>
              <p>{{ book.data.author }}</p>
            </a>
          {% endfor %}
        </div>
      {% else %}
        <p>No current reads.</p>
      {% endif %}

    </div>

    <hr>

    <h2>Library:</h2>

    {% from "bookCardMacro.njk" import bookCard %}

    {% set libraryBooks = collections.books | filterNotTruthy("currentRead") | sortByLatestReadDesc(collections.reads) %}
    <div class="book-grid">
      {% for book in libraryBooks %}
        {{ bookCard(book) }}
      {% endfor %}
    </div>

  </section>

  <aside class="sidebar sidebar-right">
    {% if page.url == "/" %}
      {% include "randomBook.njk" %}
    {% endif %}
  </aside>

</div>