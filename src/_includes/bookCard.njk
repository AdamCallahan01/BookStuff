<a href="{{ book.url }}" class="book-card">
    {% if book.data.coverSlug %}
        <img src="/files/covers/{{ book.data.coverSlug }}.jpg" alt="{{ book.data.title }} cover">
    {% endif %}
    <div class="overlay">
            ⭐ {% if book.data.hasScore %}{{ book.data.averageScore }}
        {% else %}N/A{% endif %}
            | 📖 {{ book.data.readCount }}
    </div>
    <h2>{{ book.data.title }}</h2>
    <p>{{ book.data.author }}</p>
</a>